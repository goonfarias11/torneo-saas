generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS
// ============================================

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationUsers OrganizationUser[]
}

// ============================================
// ORGANIZACIONES
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       OrganizationUser[]
  tournaments Tournament[]
  teams       Team[]
  templates   TournamentTemplate[]
  ruleOverrides OrganizationSportRule[]
  people      Person[]
  teamMembers TeamMember[]

  @@index([slug])
}

model OrganizationUser {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("EDITOR")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ============================================
// TORNEOS
// ============================================

model Tournament {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String   @default("LEAGUE")
  sportSlug      String   @default("football")
  formatSlug     String   @default("league")
  participantMode String  @default("TEAM")
  competitionMode String @default("LEAGUE")
  status         String   @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?

  pointsForWin   Int @default(3)
  pointsForDraw  Int @default(1)
  pointsForLoss  Int @default(0)
  pointsForBye   Int @default(0)

  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  fixtureConfig   String @default("{}")
  statisticsConfig String @default("{}")
  uiConfig        String @default("{}")
  customRules     String @default("{}")
  presetSlug      String?
  templateId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     TournamentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  participants TournamentTeam[]
  matches      Match[]
  rounds       Round[]

  @@index([organizationId])
  @@index([sportSlug])
  @@index([formatSlug])
  @@index([status])
}

model TournamentTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  sportSlug      String
  formatSlug     String
  participantMode String
  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  fixtureConfig   String @default("{}")
  statisticsConfig String @default("{}")
  isSystem        Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournaments  Tournament[]

  @@index([organizationId])
  @@index([sportSlug])
  @@index([formatSlug])
}

model OrganizationSportRule {
  id             String   @id @default(cuid())
  organizationId String
  sportSlug      String
  formatSlug     String?
  name           String
  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sportSlug])
  @@unique([organizationId, sportSlug, formatSlug, name])
}

// ============================================
// EQUIPOS
// ============================================

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  shortName      String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournaments  TournamentTeam[]
  members      TeamMember[]
  homeMatches  Match[]          @relation("HomeTeam")
  awayMatches  Match[]          @relation("AwayTeam")
  matchParticipants MatchParticipant[]
  matchEvents  MatchEvent[]
  playerStatistics PlayerStatistic[]
  tournamentStatistics TournamentStatistic[]
  seasonStatistics SeasonStatistic[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
}

// ============================================
// PERSONAS, PLANTELES Y PARTICIPANTES
// ============================================

model Person {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String?
  displayName    String
  birthDate      DateTime?
  nationality    String?
  avatarUrl      String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberships TeamMember[]
  matchParticipants MatchParticipant[]
  matchEvents MatchEvent[] @relation("EventPerson")
  relatedMatchEvents MatchEvent[] @relation("RelatedEventPerson")
  playerStatistics PlayerStatistic[]
  tournamentStatistics TournamentStatistic[]
  seasonStatistics SeasonStatistic[]

  @@index([organizationId])
  @@index([displayName])
}

model TeamMember {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String?
  personId       String
  sportSlug      String
  memberType     String   @default("PLAYER")
  positionSlug   String?
  roleSlug       String?
  jerseyNumber   String?
  status         String   @default("ACTIVE")
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([memberType])
  @@unique([teamId, personId, sportSlug, memberType])
}

// ============================================
// PARTIDOS
// ============================================

model Round {
  id           String    @id @default(cuid())
  tournamentId String
  number       Int
  name         String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([tournamentId, number])
  @@index([tournamentId])
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  roundId      String?
  homeTeamId   String
  awayTeamId   String

  scheduledAt DateTime?
  playedAt    DateTime?

  homeScore Int?
  awayScore Int?

  status String @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round      Round?     @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeTeam   Team       @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam   Team       @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]
  events     MatchEvent[]
  playerStatistics PlayerStatistic[]

  @@index([tournamentId])
  @@index([roundId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
}

model MatchParticipant {
  id        String   @id @default(cuid())
  matchId   String
  teamId    String?
  personId  String?
  side      String?
  role      String   @default("PLAYER")
  started   Boolean  @default(false)
  minutesPlayed Int?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([teamId])
  @@index([personId])
}

model MatchEvent {
  id              String   @id @default(cuid())
  matchId          String
  tournamentId     String
  sportSlug        String
  eventSlug        String
  teamId           String?
  personId         String?
  relatedPersonId  String?
  opponentTeamId   String?
  minute           Int?
  period           String?
  value            Float   @default(1)
  metadata         String  @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person        Person? @relation("EventPerson", fields: [personId], references: [id], onDelete: SetNull)
  relatedPerson Person? @relation("RelatedEventPerson", fields: [relatedPersonId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([tournamentId])
  @@index([sportSlug])
  @@index([eventSlug])
  @@index([teamId])
  @@index([personId])
}

model PlayerStatistic {
  id           String   @id @default(cuid())
  personId     String
  teamId       String?
  tournamentId String?
  matchId      String?
  sportSlug    String
  statSlug     String
  scope        String   @default("MATCH")
  value        Float    @default(0)
  metadata     String   @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  match  Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([teamId])
  @@index([tournamentId])
  @@index([matchId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([personId, teamId, tournamentId, matchId, sportSlug, statSlug, scope])
}

model TournamentStatistic {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String?
  personId     String?
  sportSlug    String
  statSlug     String
  value        Float    @default(0)
  metadata     String   @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([tournamentId, teamId, personId, sportSlug, statSlug])
}

model SeasonStatistic {
  id             String   @id @default(cuid())
  organizationId String
  seasonSlug      String
  teamId         String?
  personId       String?
  sportSlug      String
  statSlug       String
  value          Float    @default(0)
  metadata       String   @default("{}")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([seasonSlug])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([organizationId, seasonSlug, teamId, personId, sportSlug, statSlug])
}

model LeaderboardSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  tournamentId   String?
  sportSlug      String
  leaderboardSlug String
  scope          String   @default("TOURNAMENT")
  rows           String   @default("[]")
  generatedAt    DateTime @default(now())

  @@index([organizationId])
  @@index([tournamentId])
  @@index([sportSlug])
  @@index([leaderboardSlug])
}
