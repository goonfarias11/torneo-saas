generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS
// ============================================

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationUsers OrganizationUser[]
}

// ============================================
// ORGANIZACIONES
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       OrganizationUser[]
  tournaments Tournament[]
  teams       Team[]
  templates   TournamentTemplate[]
  ruleOverrides OrganizationSportRule[]
  people      Person[]
  teamMembers TeamMember[]
  subscriptions Subscription[]
  billingCustomers BillingCustomer[]
  organizationSubscriptions OrganizationSubscription[]
  invoices Invoice[]
  payments Payment[]
  usageRecords UsageRecord[]

  @@index([slug])
}

model OrganizationUser {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("EDITOR")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ============================================
// TORNEOS
// ============================================

model Tournament {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String   @default("LEAGUE")
  sportSlug      String   @default("football")
  formatSlug     String   @default("league")
  participantMode String  @default("TEAM")
  competitionMode String @default("LEAGUE")
  status         String   @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?

  pointsForWin   Int @default(3)
  pointsForDraw  Int @default(1)
  pointsForLoss  Int @default(0)
  pointsForBye   Int @default(0)

  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  fixtureConfig   String @default("{}")
  statisticsConfig String @default("{}")
  uiConfig        String @default("{}")
  customRules     String @default("{}")
  presetSlug      String?
  templateId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     TournamentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  participants TournamentTeam[]
  matches      Match[]
  rounds       Round[]

  @@index([organizationId])
  @@index([sportSlug])
  @@index([formatSlug])
  @@index([status])
}

model TournamentTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  sportSlug      String
  formatSlug     String
  participantMode String
  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  fixtureConfig   String @default("{}")
  statisticsConfig String @default("{}")
  isSystem        Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournaments  Tournament[]

  @@index([organizationId])
  @@index([sportSlug])
  @@index([formatSlug])
}

model OrganizationSportRule {
  id             String   @id @default(cuid())
  organizationId String
  sportSlug      String
  formatSlug     String?
  name           String
  rulesConfig     String @default("{}")
  scoringConfig   String @default("{}")
  standingsConfig String @default("{}")
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sportSlug])
  @@unique([organizationId, sportSlug, formatSlug, name])
}

// ============================================
// EQUIPOS
// ============================================

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  shortName      String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournaments  TournamentTeam[]
  members      TeamMember[]
  homeMatches  Match[]          @relation("HomeTeam")
  awayMatches  Match[]          @relation("AwayTeam")
  matchParticipants MatchParticipant[]
  matchEvents  MatchEvent[]
  playerStatistics PlayerStatistic[]
  tournamentStatistics TournamentStatistic[]
  seasonStatistics SeasonStatistic[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
}

// ============================================
// PERSONAS, PLANTELES Y PARTICIPANTES
// ============================================

model Person {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String?
  displayName    String
  birthDate      DateTime?
  nationality    String?
  avatarUrl      String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberships TeamMember[]
  matchParticipants MatchParticipant[]
  matchEvents MatchEvent[] @relation("EventPerson")
  relatedMatchEvents MatchEvent[] @relation("RelatedEventPerson")
  playerStatistics PlayerStatistic[]
  tournamentStatistics TournamentStatistic[]
  seasonStatistics SeasonStatistic[]

  @@index([organizationId])
  @@index([displayName])
}

model TeamMember {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String?
  personId       String
  sportSlug      String
  memberType     String   @default("PLAYER")
  positionSlug   String?
  roleSlug       String?
  jerseyNumber   String?
  status         String   @default("ACTIVE")
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([memberType])
  @@unique([teamId, personId, sportSlug, memberType])
}

// ============================================
// PARTIDOS
// ============================================

model Round {
  id           String    @id @default(cuid())
  tournamentId String
  number       Int
  name         String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([tournamentId, number])
  @@index([tournamentId])
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  roundId      String?
  homeTeamId   String
  awayTeamId   String

  scheduledAt DateTime?
  playedAt    DateTime?

  homeScore Int?
  awayScore Int?

  status String @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round      Round?     @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeTeam   Team       @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam   Team       @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]
  events     MatchEvent[]
  playerStatistics PlayerStatistic[]

  @@index([tournamentId])
  @@index([roundId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
}

model MatchParticipant {
  id        String   @id @default(cuid())
  matchId   String
  teamId    String?
  personId  String?
  side      String?
  role      String   @default("PLAYER")
  started   Boolean  @default(false)
  minutesPlayed Int?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([teamId])
  @@index([personId])
}

model MatchEvent {
  id              String   @id @default(cuid())
  matchId          String
  tournamentId     String
  sportSlug        String
  eventSlug        String
  teamId           String?
  personId         String?
  relatedPersonId  String?
  opponentTeamId   String?
  minute           Int?
  period           String?
  value            Float   @default(1)
  metadata         String  @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person        Person? @relation("EventPerson", fields: [personId], references: [id], onDelete: SetNull)
  relatedPerson Person? @relation("RelatedEventPerson", fields: [relatedPersonId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([tournamentId])
  @@index([sportSlug])
  @@index([eventSlug])
  @@index([teamId])
  @@index([personId])
}

model PlayerStatistic {
  id           String   @id @default(cuid())
  personId     String
  teamId       String?
  tournamentId String?
  matchId      String?
  sportSlug    String
  statSlug     String
  scope        String   @default("MATCH")
  value        Float    @default(0)
  metadata     String   @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  match  Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([teamId])
  @@index([tournamentId])
  @@index([matchId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([personId, teamId, tournamentId, matchId, sportSlug, statSlug, scope])
}

model TournamentStatistic {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String?
  personId     String?
  sportSlug    String
  statSlug     String
  value        Float    @default(0)
  metadata     String   @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([tournamentId, teamId, personId, sportSlug, statSlug])
}

model SeasonStatistic {
  id             String   @id @default(cuid())
  organizationId String
  seasonSlug      String
  teamId         String?
  personId       String?
  sportSlug      String
  statSlug       String
  value          Float    @default(0)
  metadata       String   @default("{}")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([seasonSlug])
  @@index([teamId])
  @@index([personId])
  @@index([sportSlug])
  @@index([statSlug])
  @@unique([organizationId, seasonSlug, teamId, personId, sportSlug, statSlug])
}

model LeaderboardSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  tournamentId   String?
  sportSlug      String
  leaderboardSlug String
  scope          String   @default("TOURNAMENT")
  rows           String   @default("[]")
  generatedAt    DateTime @default(now())

  @@index([organizationId])
  @@index([tournamentId])
  @@index([sportSlug])
  @@index([leaderboardSlug])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  currency    String   @default("USD")
  interval    String   @default("MONTHLY")
  amount      Int
  isFree      Boolean  @default(false)
  isEnterprise Boolean  @default(false)
  features    String   @default("[]")
  limits      String   @default("{}")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  featureLimits FeatureLimit[]
}

model Feature {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String
  isPremium   Boolean    @default(false)
  isEnterprise Boolean   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FeatureLimit {
  id          String     @id @default(cuid())
  planId      String
  featureKey  String
  limitValue  Int
  unit        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model Addon {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  amount      Int
  currency    String   @default("USD")
  interval    String
  features    String   @default("[]")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptionAddons SubscriptionAddon[]
}

model BillingCustomer {
  id                String           @id @default(cuid())
  organizationId    String           @unique
  provider          String
  providerCustomerId String
  email             String
  name              String
  metadata          String           @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                    String   @id @default(cuid())
  organizationId        String
  planId                String
  status                String   @default("TRIAL")
  provider              String
  providerSubscriptionId String
  interval              String
  amount                Int
  currency              String   @default("USD")
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean  @default(false)
  canceledAt            DateTime?
  metadata              String   @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  addons SubscriptionAddon[]
  invoices Invoice[]
  discounts Discount[]
  organizationSubscriptions OrganizationSubscription[]
}

model OrganizationSubscription {
  id             String   @id @default(cuid())
  organizationId String
  subscriptionId String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, subscriptionId])
}

model SubscriptionAddon {
  id             String   @id @default(cuid())
  subscriptionId String
  addonId        String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, addonId])
}

model Invoice {
  id               String   @id @default(cuid())
  organizationId   String
  subscriptionId   String
  providerInvoiceId String
  amountDue        Int
  amountPaid       Int
  currency         String   @default("USD")
  status           String
  dueDate          DateTime
  periodStart      DateTime
  periodEnd        DateTime
  pdfUrl           String?
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id               String   @id @default(cuid())
  invoiceId        String
  organizationId   String
  providerPaymentId String
  amount           Int
  currency         String   @default("USD")
  paymentMethod    String
  status           String   @default("PENDING")
  paidAt           DateTime
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discountType   String
  amountOff      Int?
  percentOff     Int?
  maxRedemptions Int?
  redeemed       Int      @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean  @default(true)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  discounts      Discount[]
}

model Discount {
  id             String   @id @default(cuid())
  subscriptionId String
  couponId       String
  amount         Int?
  percent        Int?
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model UsageMetric {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  unit        String
  aggregation String
  metadata    String           @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  records     UsageRecord[]
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metricKey      String
  periodStart    DateTime
  periodEnd      DateTime
  usage          Int      @default(0)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric UsageMetric @relation(fields: [metricKey], references: [key], onDelete: Cascade)

  @@unique([organizationId, metricKey, periodStart])
}
